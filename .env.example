# Databricks Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env to version control!

# Databricks Workspace URL (e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com)
DATABRICKS_HOST=https://dbc-04d9345b-e99c.cloud.databricks.com

# Databricks Personal Access Token (dapi...)
DATABRICKS_TOKEN=dapi_your_pat_token_here

# Databricks SQL Warehouse ID (Optional - HTTP Path or Warehouse ID)
DATABRICKS_SQL_WAREHOUSE_ID=

# Local MySQL Database Configuration (OLTP Source Simulation)
# Note: If your password contains special characters like #, wrap it in single quotes (e.g. 'MyPass#123')
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=wanderbricks
LOCAL_MYSQL_USER=wanderbricks_etl
LOCAL_MYSQL_PASSWORD='Sh@m#1718'
